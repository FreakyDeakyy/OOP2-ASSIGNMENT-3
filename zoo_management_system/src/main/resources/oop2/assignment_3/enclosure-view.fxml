<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.*?>

<VBox alignment="CENTER" spacing="15.0" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="oop2.assignment_3.EnclosureViewController">
    <padding>
        <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
    </padding>

    <!-- Enclosure Title / Header -->
    <Label fx:id="enclosureTitleLabel" text="Enclosure Name">
        <font>
            <Font name="System Bold" size="20.0" />
        </font>
    </Label>

    <!-- Animal ListView matching the whiteboard sketch -->
    <ListView fx:id="animalListView" prefHeight="250.0" prefWidth="300.0" />

    <!-- Action Buttons (Add, Delete) -->
    <HBox alignment="CENTER" spacing="10.0">
        <Button fx:id="addButton" mnemonicParsing="false" onAction="#handleAddAnimal" prefWidth="80.0" text="Add" />
        <Button fx:id="deleteButton" mnemonicParsing="false" onAction="#handleRemoveAnimal" prefWidth="80.0" text="Delete" />
        <Button fx:id="openButton" mnemonicParsing="false" onAction="#handleOpenAnimal" prefWidth="80.0" text="Open" />
    </HBox>

    <!-- Back Button -->
    <HBox alignment="BOTTOM_LEFT">
        <Button fx:id="backButton" mnemonicParsing="false" onAction="#handleBack" text="Back" />
    </HBox>
</VBox>
